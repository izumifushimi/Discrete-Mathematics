[
  {"type":"choice","q":"同余方程 \\(6x\\equiv4\\pmod 9\\)","options":["无解","恰有 1 个模 9 的解","恰有 3 个模 9 的解","有无穷多个模 9 不同的解"],"answer":0,"why":"\\(\\gcd(6,9)=3\\nmid4\\)，由有解条件知无解。"},
  {"type":"fill","q":"\\(4x\\equiv2\\pmod 6\\) 的最小正整数解为 ____","answer":["2"],"why":"\\(\\gcd(4,6)=2\\mid2\\) 有解；\\(4\\times2=8\\equiv2\\)，\\(x=1\\) 时 \\(4\\not\\equiv2\\)。"},
  {"type":"fill","q":"\\(8x\\equiv4\\pmod6\\) 在 \\(0\\le x\\le5\\) 内的解有 ____ 个","answer":["2","两"],"why":"\\(x=2\\)（16≡4）与 \\(x=5\\)（40≡4）。"},
  {"type":"fill","q":"\\(3^{-1}\\pmod{11}=\\) ____（取 0~10 中的值）","answer":["4"],"why":"\\(3\\times4=12\\equiv1\\pmod{11}\\)。"},
  {"type":"fill","q":"\\(7^{-1}\\pmod{26}=\\) ____（取 0~25 中的值）","answer":["15"],"why":"\\(26=3\\times7+5\\)，\\(7=1\\times5+2\\)，\\(5=2\\times2+1\\)；回代 \\(1=5-2\\times2=3\\times5-2\\times7=3\\times26-11\\times7\\)，\\(-11\\equiv15\\)；验算 \\(7\\times15=105=4\\times26+1\\)。"},
  {"type":"choice","q":"下列模逆不存在的是","options":["\\(5^{-1}\\pmod 7\\)","\\(6^{-1}\\pmod 9\\)","\\(2^{-1}\\pmod 9\\)","\\(4^{-1}\\pmod 9\\)"],"answer":1,"why":"\\(\\gcd(6,9)=3\\neq1\\)，模逆存在当且仅当互素。"},
  {"type":"fill","q":"\\(\\varphi(12)=\\) ____","answer":["4"],"why":"0~11 中与 12 互素的是 1, 5, 7, 11。"},
  {"type":"fill","q":"由费马小定理，\\(2^{100}\\bmod 13=\\) ____","answer":["3"],"why":"\\(2^{12}\\equiv1\\pmod{13}\\)，\\(100=12\\times8+4\\)，\\(2^4=16\\equiv3\\)。"},
  {"type":"choice","q":"关于欧拉函数，正确的是","options":["\\(\\varphi(9)=8\\)","\\(\\varphi(p)=p-1\\)（\\(p\\) 为素数）","\\(\\varphi(6)=3\\)","合数 \\(n\\) 满足 \\(\\varphi(n)=n-1\\)"],"answer":1,"why":"\\(\\varphi(9)=6\\)，\\(\\varphi(6)=2\\)，合数时 \\(\\varphi(n)\\lt n-1\\)。"}
]
